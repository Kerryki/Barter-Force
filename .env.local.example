# Contact form email (Resend, https://resend.com). All three are required in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Shared rate limiting (Upstash Redis REST). Optional but recommended on serverless hosting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Calendar embed (optional). Calendly or Cal.com URL, https only.
NEXT_PUBLIC_CALENDAR_URL=

# Google Analytics (optional). Only loaded after the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=

# Fallback business phone for JSON-LD until src/content/broker.ts has one (optional)
NEXT_PUBLIC_BUSINESS_PHONE=

# Show unpublished articles in a production build (optional)
SHOW_DRAFT_ARTICLES=
